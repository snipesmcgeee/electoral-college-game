rules_version = '2';
// Paste into Firebase console → Firestore → Rules, then Publish.
// Admins (you) sign in with Google and are listed in the `admins` collection (doc ID = your UID).
// Players, the board and phones sign in anonymously.
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && exists(/databases/$(db)/documents/admins/$(request.auth.uid)); }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false; // add yourself by hand in the console
    }

    // Answers live here, so only admins can read the warehouse.
    match /questions/{id} {
      allow read, write: if isAdmin();
    }

    match /profiles/{id} {
      allow read: if signedIn();
      allow create: if signedIn();            // new players at the door
      allow update, delete: if isAdmin();     // seen-it logging is done by the host
    }

    match /games/{code} {
      function game() { return get(/databases/$(db)/documents/games/$(code)).data; }
      function me() { return get(/databases/$(db)/documents/games/$(code)/players/$(request.auth.uid)).data; }
      function playerLock() {
        let p = me();
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return resource.data.status == 'spending'
          && changed.hasOnly(['locked'])
          && request.resource.data.locked.diff(resource.data.locked).affectedKeys().hasOnly([p.team])
          && request.resource.data.locked[p.team] == true
          && (resource.data.settings.lockBy == 'anyone' || resource.data.leaders[p.team] == request.auth.uid);
      }

      allow read: if signedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (signedIn() && playerLock());

      match /players/{uid} {
        allow read: if signedIn();
        allow create: if signedIn() && request.auth.uid == uid;
        allow update: if isAdmin() || (signedIn() && request.auth.uid == uid && game().status == 'lobby');
        allow delete: if isAdmin();
      }

      // Each party's private spending plan for the current round.
      match /drafts/{team} {
        allow read: if isAdmin() || (signedIn() && me().team == team);
        allow write: if isAdmin() || (signedIn() && me().team == team
          && game().status == 'spending' && game().locked[team] != true);
      }

      // Answer IDs: <questionId>__<team> in party mode, <questionId>__<uid> in candidate mode.
      match /answers/{aid} {
        allow get: if isAdmin() || (signedIn() && aid.split('__')[1] in [me().team, request.auth.uid]);
        allow list: if isAdmin();
        allow create, update: if signedIn()
          && game().answersOpen == true
          && request.resource.data.qid == game().current.id
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.team == me().team
          && aid == request.resource.data.qid + '__' + (game().settings.mode == 'party' ? me().team : request.auth.uid);
        allow delete: if isAdmin();
      }

      match /log/{n} {
        allow read, write: if isAdmin();
      }
    }
  }
}
