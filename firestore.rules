rules_version = '2';
// Paste into Firebase console → Firestore → Rules, then Publish.
// Every device signs in anonymously (invisible to players). That's the only check:
// it keeps random bots off the database without any logins for people.
service cloud.firestore {
  match /databases/{db}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
